{
    "name": "fourwit/identity",
    "description": "Production-ready User Identity Management Module for Laravel 13+",
    "keywords": [
        "laravel",
        "module",
        "user",
        "identity",
        "authentication",
        "user-management",
        "api",
        "blade"
    ],
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Fourwit Technologies Pvt. Ltd.",
            "email": "admin@fourwittechnologies.com"
        }
    ],
    "homepage": "https://github.com/fourwit/identity",
    "support": {
        "issues": "https://github.com/fourwit/identity/issues",
        "source": "https://github.com/fourwit/identity"
    },
    "require": {
        "php": "^8.4",
        "nwidart/laravel-modules": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Identity\\": "app/",
            "Modules\\Identity\\Database\\Factories\\": "database/factories/",
            "Modules\\Identity\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Identity\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Identity\\Providers\\IdentityServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}